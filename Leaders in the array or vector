
#include <iostream>
#include <vector>
#include <algorithm>
#include <climits>
using namespace std;

class Solution {
public:
    vector<int> removeDuplicates(vector<int>& a) {
        int maxVal = INT_MIN;
        int n = a.size();
        vector<int> ans;

        for (int i = 0; i < n; i++) {
            if (a[i] > maxVal) {
                ans.push_back(a[i]);
            }
            maxVal = max(maxVal, a[i]);
        }

        sort(ans.begin(), ans.end());
        return ans;
    }
};
