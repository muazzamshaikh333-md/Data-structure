#include <iostream>
#include <vector>
using namespace std;

int main()
{
    vector<int> numbers;
    int n, x;

    cout << "How many numbers: ";
    cin >> n;

    for (int i = 0; i < n; i++)
    {
        cin >> x;
        numbers.push_back(x);
    }

    cout << "Vector Elements: ";

    for (int i = 0; i < numbers.size(); i++)
    {
        cout << numbers[i] << " ";
    }

    return 0;
}
